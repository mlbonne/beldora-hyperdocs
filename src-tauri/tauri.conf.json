{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Beldora HyperDocs",
  "version": "0.1.0",
  "identifier": "com.beldora.hyperdocs",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Write chapters, build your world's wiki.",
    "longDescription": "A writing app where every chapter is fed by a wiki of characters, locations, items, concepts and dynamics.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}